# conf/pipeline.env: configuration (no secrets)
# Overridable from the environment; smoke defaults for this week.
# Only REF and REGION change between the smoke run and the Explorer run.
REF="${REF:-smoke/smoke.fa}"
REGION="${REGION:-smoke_1mb}"
THREADS="${THREADS:-4}"

# MultiQC binary. An isolated venv avoids the system NumPy ABI clash on this
# laptop; on Explorer this points at the course environment's multiqc instead.
MULTIQC="${MULTIQC:-$HOME/mqc-venv/bin/multiqc}"
