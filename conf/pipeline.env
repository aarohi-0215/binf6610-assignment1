# conf/pipeline.env — pipeline configuration (no secrets in here)
# Sourced by run_pipeline.sh. Every value has a sensible default so the
# pipeline runs without editing code; override by exporting before a run.

# --- reference genome (whole GRCh38 for alignment) ---
REF_DIR="${REF_DIR:-data/refs/grch38}"
REF_FASTA="${REF_FASTA:-${REF_DIR}/genome.fa}"

# --- variant CALLING is restricted to this region, not the reference ---
# Align to the whole genome; call only here. See README: a subset reference
# makes reads whose true home is elsewhere pile up here with high MAPQ.
CALL_REGION="${CALL_REGION:-chr20:1-10000000}"

# --- resources ---
THREADS="${THREADS:-4}"

# --- grouping factor for joint stages (synthetic phenotype in this cohort) ---
CONDITION_REF="${CONDITION_REF:-unaffected}"
