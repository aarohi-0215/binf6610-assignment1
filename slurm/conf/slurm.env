# slurm/conf/slurm.env: cluster-specific settings ONLY. No biology here.
# Sourced by the batch scripts. Everything Explorer-specific lives in this file.

# Scheduler
PARTITION="short"                 # Explorer: 252 nodes, 2-day limit (from hpc_check)

# Per-sample array task resources (stages 0-5: alignment + calling on one sample)
PERSAMPLE_CPUS=8
PERSAMPLE_MEM=24G
PERSAMPLE_TIME=00:30:00

# Cohort job resources (stages 6-9: joint genotyping across all samples)
COHORT_CPUS=2
COHORT_MEM=4G
COHORT_TIME=00:30:00

# The course conda environment (holds the analysis tools the pipeline calls)
CONDA_MODULE="miniconda3/25.9.1"
CONDA_ENV="/courses/BINF6610.202710/shared/env/binf6610"

# The samplesheet the array indexes into (8 cohort samples, Explorer paths)
SAMPLESHEET="samplesheet.cluster.csv"

# Where run outputs go (under scratch, never committed)
SCRATCH_DIR="/scratch/$(id -un)"
SIF="${SCRATCH_DIR}/containers/variant-call.sif"
OUTDIR="${SCRATCH_OUT:-${SCRATCH_DIR}/w3-run}"

#-----------------------------------------------------------------------------
# The reference and calling region for the REAL run. These are the only two
# values that change between the smoke run and Explorer.
#
# They are EXPORTED (and absolute) so that run_pipeline.sh, a child process,
# inherits them. run_pipeline.sh reads REF="${REF:-smoke/smoke.fa}": if REF is
# NOT in the environment it falls back to the smoke default, a relative path that
# does not exist on Explorer, and the aligner then hangs on a bad reference. A
# plain (unexported) assignment is not inherited by the child, so `export` is
# what makes this work rather than silently fail.
#-----------------------------------------------------------------------------
export REF="/courses/BINF6610.202710/data/refs/grch38-1000g/GRCh38_full_analysis_set_plus_decoy_hla.fa"
export REGION="chr20:1-10000000"
